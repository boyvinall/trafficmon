.*
!.gitignore
!.github
!.claude
!.golangci.yml
!.goreleaser.yaml

bin/
dist/
*.test
*.out

# bpf2go-generated bindings + compiled BPF objects (see procinfo/bpf/*/gen_linux.go);
# regenerate with `make bpf-generate`.
procinfo/bpf/**/*_bpfel.go
procinfo/bpf/**/*_bpfeb.go
procinfo/bpf/**/*.o

# ocb-generated collector distribution sources (go.mod/go.sum, components.go,
# main*.go); regenerate with `make build-otel-collector`.
cmd/otel-collector/go.mod
cmd/otel-collector/go.sum
cmd/otel-collector/components.go
cmd/otel-collector/main.go
cmd/otel-collector/main_others.go
cmd/otel-collector/main_windows.go

*.md
!README.md
